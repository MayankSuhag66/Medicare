{
  "version": 2,
  "builds": [
    { "src": "api/*.py", "use": "@vercel/python" },
    { "src": "index.html", "use": "@vercel/static" },
    { "src": "favicon.ico", "use": "@vercel/static" },
    { "src": "og-image.png", "use": "@vercel/static" },
    { "src": "app.js", "use": "@vercel/static" },
    { "src": "styles.css", "use": "@vercel/static" },
    { "src": "theme.css", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/status", "dest": "/api/status.py" },
    { "src": "/api/config", "dest": "/api/config.py" },
    { "src": "/api/chat", "dest": "/api/chat.py" },
    { "src": "/api/analyze", "dest": "/api/analyze.py" },
    { "src": "/", "dest": "/index.html" },
    { "handle": "filesystem" }
  ]
}
